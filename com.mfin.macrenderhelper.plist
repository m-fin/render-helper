<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mfin.macrenderhelper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/Library/Application Support/macrenderhelper/rh_worker.py</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/Library/Application Support/macrenderhelper</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/macrenderhelper.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/macrenderhelper.log</string>
